    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Amble verbindet sich über Bluetooth mit deinem Walking Pad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amble connects to your walking pad over Bluetooth."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Amble liest die Spaziergänge, die es gespeichert hat, für Verlauf, Ziele und Erfolge, und deine durchschnittliche Schrittlänge und Körpergröße, um Schritte zu schätzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amble reads back the walks it saved, for your history, goals and achievements, and your average step length and height to estimate steps."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Amble speichert deine Spaziergänge auf dem Walking Pad (Strecke, Energie, Schritte) in Apple Health."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amble saves your treadmill walks (distance, energy, steps) to Apple Health."
          }
        }
      }
    }
  },
  "version": "1.0"
