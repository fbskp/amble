            "value": "Demo ausprobieren"
          }
        }
      }
    },
    "Typical adults: 60 to 80 cm at normal walking pace. Walk a known distance at that pace and divide it by your steps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Typisch für Erwachsene: 60 bis 80 cm bei normalem Gehtempo. Geh in diesem Tempo eine bekannte Strecke und teile sie durch deine Schritte."
          }
        }
      }
    },
    "Unhurried": {
      "localizations": {
