    },
    "A sloth sleeping": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schlafendes Faultier"
          }
        }
      }
    },
    "A sloth walking": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Faultier beim Gehen"
          }
        }
      }
    },
    "A week runs from %@ to %@. Both goals must be reached to complete it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Woche läuft von %@ bis %@. Beide Ziele müssen erreicht werden, um sie abzuschließen."
          }
        }
      }
    },
    "Achievement unlocked": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfolg freigeschaltet"
          }
        }
      }
    },
