        }
      }
    },
    "Use Amble at your own risk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nutzung von Amble erfolgt auf eigene Gefahr."
          }
        }
      }
    },
    "Verified only with the Sportstech WalkMate. Other pads that use the standard Bluetooth fitness protocol (FTMS) may work, but can behave unexpectedly, for example by changing the speed on its own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher nur mit dem Sportstech WalkMate geprüft. Andere Pads mit dem Bluetooth-Fitnessstandard (FTMS) funktionieren womöglich, können sich aber unerwartet verhalten, zum Beispiel die Geschwindigkeit von selbst ändern."
          }
        }
      }
    },
